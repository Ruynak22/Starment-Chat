rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /chat-images/{chatId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /chat-files/{chatId}/{allPaths=**} {
      allow read: if request.auth != null;
      // Khớp với MAX_FILE_SIZE (10MB) trong js/storage.js
      allow write: if request.auth != null
        && request.resource.size <= 10 * 1024 * 1024;
    }
    // Tệp cá nhân của từng tài khoản (Tệp của tôi / My Documents)
    match /userDocuments/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
